# Cloudflare Pages security headers — applied to every response.
# The strict CSP is Report-Only for now (logs violations to the browser console,
# blocks nothing). Once you've confirmed no legit resource is reported, the
# Report-Only line can be promoted to an enforcing "Content-Security-Policy".

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://assets.calendly.com https://www.gstatic.com https://challenges.cloudflare.com https://widget-cdn.simplepractice.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://openpath-intake.roblesinc.workers.dev https://challenges.cloudflare.com https://*.clientsecure.me https://widget-cdn.simplepractice.com; frame-src https://assets.calendly.com https://calendly.com https://challenges.cloudflare.com https://www.google.com https://maps.google.com https://*.clientsecure.me; frame-ancestors 'self'; object-src 'none'; base-uri 'self'

# The link-preview card. It is referenced only by the og:image meta tag and is
# never shown on a page, so keep it out of image search too.
/images/og-card-v4.png
  X-Robots-Tag: noindex

# Internal preview pages. These are kept out of the index with a header rather
# than a robots.txt Disallow: a disallowed URL is never fetched, so the crawler
# can never read a noindex on it and the bare URL can still be listed. A header
# is fetched and obeyed. mailchimp-campaign.html is a raw email fragment with no
# <head>, so a header is the only way to mark it at all.
/email-preview
  X-Robots-Tag: noindex, nofollow
/report-preview
  X-Robots-Tag: noindex, nofollow
/mailchimp-campaign
  X-Robots-Tag: noindex, nofollow

# Fingerprint-free static assets. A week of browser caching with revalidation
# keeps repeat visits cheap without risking a stale stylesheet after a deploy.
/assets/*
  Cache-Control: public, max-age=604800, must-revalidate
/images/*
  Cache-Control: public, max-age=2592000
