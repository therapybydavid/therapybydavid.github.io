  <style>
    :root {
      --ink: #080b10;
      --night: #101720;
      --navy: #142132;
      --champagne: #d8b866;
      --gold: #b99138;
      --cream: #f5efe3;
      --paper: #fbf8f1;
      --mist: #e8decc;
      --text: #15171b;
      --muted: #6a6258;
      --white: #ffffff;
      --line: rgba(216, 184, 102, .25);
      --shadow: 0 24px 80px rgba(0,0,0,.18);
      --radius: 28px;
      --max: 1180px;
      --serif: 'Playfair Display', Georgia, serif;
      --sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--sans);
      background: var(--paper);
      color: var(--text);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    p { color: var(--muted); max-width: 68ch; }
    .container { max-width: var(--max); margin: 0 auto; padding: 0 24px; }
    .section { padding: 104px 0; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--gold);
      font-size: 12px;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-weight: 800;
      margin-bottom: 18px;
    }
    .eyebrow::before { content: ''; width: 34px; height: 1px; background: currentColor; opacity: .6; }
    h1, h2, h3 { font-family: var(--serif); color: var(--night); line-height: 1.05; letter-spacing: -.03em; }
    h1 { font-size: clamp(42px, 6vw, 80px); font-weight: 700; }
    h2 { font-size: clamp(34px, 4.5vw, 58px); font-weight: 700; margin-bottom: 20px; }
    h3 { font-size: 25px; font-weight: 650; }
    .lead { font-size: clamp(17px, 2vw, 21px); color: rgba(255,255,255,.74); line-height: 1.7; }
    .section-lead { font-size: 18px; line-height: 1.8; margin-bottom: 16px; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 54px;
      padding: 15px 25px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: .02em;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease;
      border: 1px solid transparent;
      cursor: pointer;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-gold { background: linear-gradient(135deg, var(--champagne), var(--gold)); color: #16100a; box-shadow: 0 16px 38px rgba(185,145,56,.32); }
    .btn-ghost { color: var(--white); border-color: rgba(255,255,255,.22); background: rgba(255,255,255,.04); backdrop-filter: blur(10px); }
    .btn-dark { color: var(--white); background: var(--night); border-color: var(--night); }
    .btn-dark:hover { background: #1c2a3a; }
    .btn-light { color: var(--night); border-color: rgba(20,33,50,.18); background: rgba(255,255,255,.62); }

    /* Nav */
    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 50;
      background: rgba(8,11,16,.74);
      border-bottom: 1px solid rgba(255,255,255,.08);
      backdrop-filter: blur(18px);
    }
    .nav-inner { height: 76px; display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; flex-direction: column; line-height: 1; color: var(--white); }
    .brand strong { font-family: var(--serif); font-size: 25px; letter-spacing: -.02em; font-weight: 700; }
    .brand span { color: var(--champagne); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; margin-top: 8px; }
    .nav-links { display: flex; gap: 28px; align-items: center; list-style: none; }
    .nav-links a { color: rgba(255,255,255,.72); font-size: 14px; font-weight: 700; }
    .nav-links a:hover { color: var(--white); }
    .nav-toggle { display: none; background: transparent; border: 0; width: 42px; height: 42px; cursor: pointer; }
    .nav-toggle span { display: block; height: 2px; background: var(--white); margin: 7px; border-radius: 99px; }

    /* Page Hero */
    .page-hero {
      padding: 160px 0 110px;
      color: var(--white);
      background:
        radial-gradient(circle at 18% 55%, rgba(216,184,102,.16), transparent 42%),
        linear-gradient(135deg, rgba(8,11,16,.98) 0%, rgba(16,23,32,.95) 55%, rgba(8,11,16,.90) 100%);
      position: relative;
    }
    .page-hero::after {
      content: '';
      position: absolute; inset: auto 0 0 0; height: 120px;
      background: linear-gradient(to bottom, transparent, var(--paper));
      pointer-events: none;
    }
    .page-hero h1 { color: var(--white); max-width: 780px; margin-bottom: 24px; }
    .page-hero .lead { margin-bottom: 0; max-width: 620px; }

    /* Resources section */
    .resources-section { background: var(--paper); }

    /* Resource cards grid */
    .resource-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 52px;
    }
    .resource-card {
      background: var(--white);
      border: 1px solid rgba(216,184,102,.45);
      border-radius: var(--radius);
      padding: 34px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }
    .resource-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 64px rgba(20,33,50,.12);
      border-color: rgba(216,184,102,.7);
    }
    /* Featured workbook band */
    .feature-workbook {
      position: relative;
      overflow: hidden;
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 48px;
      align-items: center;
      background: linear-gradient(140deg, var(--night), var(--navy) 62%, var(--ink));
      border: 1px solid rgba(216,184,102,.42);
      border-radius: var(--radius);
      padding: 46px;
      margin-top: 46px;
      box-shadow: 0 30px 90px rgba(8,11,16,.22);
    }
    .feature-workbook::before {
      content: '';
      position: absolute;
      width: 460px; height: 460px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(216,184,102,.16), transparent 68%);
      top: -190px; right: -140px;
      pointer-events: none;
    }
    .feature-workbook > * { position: relative; z-index: 2; }
    .feature-workbook-art img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 18px;
      border: 1px solid rgba(216,184,102,.3);
      box-shadow: 0 22px 54px rgba(0,0,0,.45);
      transition: transform .28s ease;
    }
    .feature-workbook:hover .feature-workbook-art img { transform: translateY(-6px); }
    .feature-workbook-tag {
      display: inline-block;
      color: var(--champagne);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .feature-workbook h3 {
      font-family: var(--serif);
      color: var(--white);
      font-size: 38px;
      line-height: 1.14;
      font-weight: 600;
      margin: 14px 0 0;
    }
    .feature-workbook p {
      color: rgba(255,255,255,.76);
      margin: 16px 0 0;
      max-width: 54ch;
    }
    .feature-workbook-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: 22px;
    }
    .feature-workbook-meta span {
      color: rgba(255,255,255,.72);
      border: 1px solid rgba(216,184,102,.34);
      border-radius: 999px;
      padding: 7px 15px;
      font-size: 12.5px;
      font-weight: 600;
    }
    .feature-workbook-buy {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 20px;
      margin-top: 30px;
    }
    .feature-workbook-price {
      font-family: var(--serif);
      color: var(--white);
      font-size: 34px;
      font-weight: 700;
      line-height: 1;
    }
    .feature-workbook-price small {
      display: block;
      font-family: var(--sans);
      color: rgba(255,255,255,.55);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: .04em;
      margin-top: 7px;
    }
    .resource-card-category {
      display: inline-block;
      color: var(--gold);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .resource-card h3 {
      font-size: 24px;
      color: var(--night);
      margin: 0;
      line-height: 1.15;
    }
    .resource-card p {
      color: var(--muted);
      font-size: 15px;
      line-height: 1.75;
      max-width: unset;
      flex: 1;
    }
    .resource-card-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 13px 22px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .02em;
      color: var(--white);
      background: var(--night);
      border: 1px solid var(--night);
      transition: transform .2s ease, background .2s ease;
      align-self: flex-start;
      margin-top: 4px;
    }
    .resource-card-link:hover {
      transform: translateY(-2px);
      background: #1c2a3a;
    }

    /* Dark CTA section */
    .final-cta { background: var(--ink); color: var(--white); text-align: center; padding: 110px 0; position: relative; overflow: hidden; }
    .final-cta::before { content: ''; position: absolute; width: 540px; height: 540px; border-radius: 50%; background: radial-gradient(circle, rgba(216,184,102,.14), transparent 68%); top: -220px; right: -160px; pointer-events: none; }
    .final-cta .container { position: relative; z-index: 2; }
    .final-cta h2 { color: var(--white); max-width: 700px; margin: 0 auto 22px; }
    .final-cta p { margin: 0 auto 36px; color: rgba(255,255,255,.72); font-size: 19px; max-width: 52ch; }

    /* Footer */
    footer { background: #000000; color: rgba(255,255,255,.6); padding: 58px 0 38px; }
    .footer-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: 28px; }
    footer h3, footer h4 { color: var(--white); }
    footer h3 { font-size: 29px; margin-bottom: 12px; }
    footer h4 { font-family: var(--sans); font-size: 12px; text-transform: uppercase; letter-spacing: .16em; margin-bottom: 14px; color: var(--champagne); }
    footer ul { list-style: none; display: grid; gap: 10px; }
    footer a { color: rgba(255,255,255,.68); }
    footer a:hover { color: var(--white); }
    .copyright { border-top: 1px solid rgba(255,255,255,.08); margin-top: 42px; padding-top: 24px; font-size: 13px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

    .floating-cta { position: fixed; right: 18px; bottom: 18px; z-index: 60; box-shadow: 0 18px 50px rgba(0,0,0,.25); }
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.visible { opacity: 1; transform: none; }

    @media (max-width: 900px) {
      .nav-links { display: none; position: absolute; top: 76px; left: 0; right: 0; padding: 20px 24px 28px; background: rgba(8,11,16,.96); flex-direction: column; align-items: flex-start; border-bottom: 1px solid rgba(255,255,255,.08); }
      .nav-links.open { display: flex; }
      .nav-toggle { display: block; }
      .page-hero { padding-top: 130px; padding-bottom: 80px; }
      .resource-grid { grid-template-columns: 1fr; }
      .feature-workbook { grid-template-columns: 1fr; gap: 30px; padding: 30px; text-align: center; }
      .feature-workbook-art { max-width: 260px; margin: 0 auto; }
      .feature-workbook h3 { font-size: 29px; }
      .feature-workbook p { margin-left: auto; margin-right: auto; }
      .feature-workbook-meta,
      .feature-workbook-buy { justify-content: center; }
      .footer-grid { grid-template-columns: 1fr; }
      .section { padding: 78px 0; }
      .floating-cta { left: 18px; right: 18px; width: auto; }
      .floating-cta .btn { width: 100%; text-align: center; }
    }
  </style>
