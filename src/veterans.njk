  <style>
    :root {
      --ink: #080b10;
      --night: #101720;
      --navy: #142132;
      --champagne: #d8b866;
      --gold: #b99138;
      --cream: #f5efe3;
      --paper: #fbf8f1;
      --mist: #e8decc;
      --text: #15171b;
      --muted: #6a6258;
      --white: #ffffff;
      --line: rgba(216, 184, 102, .25);
      --shadow: 0 24px 80px rgba(0,0,0,.18);
      --radius: 28px;
      --max: 1180px;
      --serif: 'Playfair Display', Georgia, serif;
      --sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--sans);
      background: var(--paper);
      color: var(--text);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    p { color: var(--muted); max-width: 68ch; }
    .container { max-width: var(--max); margin: 0 auto; padding: 0 24px; }
    .section { padding: 104px 0; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--gold);
      font-size: 12px;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-weight: 800;
      margin-bottom: 18px;
    }
    .eyebrow::before { content: ''; width: 34px; height: 1px; background: currentColor; opacity: .6; }
    h1, h2, h3 { font-family: var(--serif); color: var(--night); line-height: 1.05; letter-spacing: -.03em; }
    h1 { font-size: clamp(46px, 7vw, 92px); font-weight: 700; }
    h2 { font-size: clamp(34px, 4.5vw, 58px); font-weight: 700; margin-bottom: 20px; }
    h3 { font-size: 25px; font-weight: 650; }
    .lead { font-size: clamp(18px, 2vw, 22px); color: rgba(255,255,255,.74); line-height: 1.7; }
    .section-lead { font-size: 18px; line-height: 1.8; margin-bottom: 16px; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 54px;
      padding: 15px 25px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: .02em;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease;
      border: 1px solid transparent;
      cursor: pointer;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-gold { background: linear-gradient(135deg, var(--champagne), var(--gold)); color: #16100a; box-shadow: 0 16px 38px rgba(185,145,56,.32); }
    .btn-ghost { color: var(--white); border-color: rgba(255,255,255,.22); background: rgba(255,255,255,.04); backdrop-filter: blur(10px); }
    .btn-dark { color: var(--white); background: var(--night); }
    .btn-light { color: var(--night); border-color: rgba(20,33,50,.18); background: rgba(255,255,255,.62); }
    .button-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }

    /* Nav */
    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 50;
      background: rgba(8,11,16,.74);
      border-bottom: 1px solid rgba(255,255,255,.08);
      backdrop-filter: blur(18px);
    }
    .nav-inner { height: 76px; display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; flex-direction: column; line-height: 1; color: var(--white); }
    .brand strong { font-family: var(--serif); font-size: 25px; letter-spacing: -.02em; font-weight: 700; }
    .brand span { color: var(--champagne); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; margin-top: 8px; }
    .nav-links { display: flex; gap: 28px; align-items: center; list-style: none; }
    .nav-links a { color: rgba(255,255,255,.72); font-size: 14px; font-weight: 700; }
    .nav-links a:hover { color: var(--white); }
    .nav-toggle { display: none; background: transparent; border: 0; width: 42px; height: 42px; cursor: pointer; }
    .nav-toggle span { display: block; height: 2px; background: var(--white); margin: 7px; border-radius: 99px; }

    /* Back link */
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--champagne);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: .02em;
      margin-bottom: 20px;
      text-decoration: none;
      transition: text-decoration .15s ease;
    }
    .back-link:hover { text-decoration: underline; }

    /* Page Hero */
    .page-hero {
      padding: 148px 0 86px;
      color: var(--white);
      background:
        radial-gradient(circle at 20% 50%, rgba(216,184,102,.18), transparent 40%),
        linear-gradient(135deg, rgba(8,11,16,.98) 0%, rgba(16,23,32,.94) 60%, rgba(8,11,16,.88) 100%);
      position: relative;
    }
    .page-hero::after {
      content: '';
      position: absolute; inset: auto 0 0 0; height: 120px;
      background: linear-gradient(to bottom, transparent, var(--paper));
      pointer-events: none;
    }
    .page-hero h1 { color: var(--white); max-width: 820px; margin-bottom: 26px; }
    .page-hero h1 em { color: var(--champagne); font-style: italic; }
    .page-hero .lead { margin-bottom: 36px; max-width: 640px; }

    /* Dark section */
    .dark-section { background: var(--ink); color: var(--white); position: relative; overflow: hidden; }
    .dark-section::before { content: ''; position: absolute; width: 540px; height: 540px; border-radius: 50%; background: radial-gradient(circle, rgba(216,184,102,.16), transparent 68%); top: -220px; right: -160px; }
    .dark-section .container { position: relative; z-index: 2; }
    .dark-section h2, .dark-section h3 { color: var(--white); }
    .dark-section p { color: rgba(255,255,255,.68); }

    /* Cards */
    .cards-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 48px; }
    .cards-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-top: 48px; }
    .cards-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; margin-top: 48px; }
    .card {
      background: rgba(255,255,255,.055);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: var(--radius);
      padding: 30px;
      transition: transform .22s ease, border-color .22s ease, background .22s ease;
    }
    .card:hover { transform: translateY(-5px); border-color: rgba(216,184,102,.42); background: rgba(255,255,255,.08); }
    .card .num { color: var(--champagne); font-size: 13px; font-weight: 900; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 22px; display: block; }
    .card h3 { margin-bottom: 12px; font-size: 22px; }

    /* Light cards */
    .lux-card {
      background: var(--white);
      border: 1px solid rgba(20,33,50,.08);
      border-radius: var(--radius);
      padding: 34px;
      box-shadow: 0 18px 60px rgba(20,33,50,.09);
    }
    .lux-card h3 { margin-bottom: 12px; }

    .light-cards-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 48px; }
    .light-cards-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-top: 48px; }
    .light-cards-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; margin-top: 48px; }

    .light-card {
      background: var(--white);
      border: 1px solid rgba(20,33,50,.08);
      border-radius: var(--radius);
      padding: 30px;
      box-shadow: 0 18px 48px rgba(20,33,50,.07);
      transition: transform .22s ease;
    }
    .light-card:hover { transform: translateY(-4px); }
    .light-card small { color: var(--gold); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 900; display: block; margin-bottom: 14px; }
    .light-card h3 { font-size: 22px; margin-bottom: 10px; }

    /* Myth-busting tags */
    .myth-tag {
      display: inline-block;
      background: rgba(216,184,102,.15);
      border: 1px solid rgba(216,184,102,.3);
      color: var(--champagne);
      font-size: 13px;
      font-weight: 800;
      padding: 6px 14px;
      border-radius: 999px;
      margin: 4px 4px 4px 0;
      letter-spacing: .04em;
    }
    .myth-busted { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }

    /* Body / Thoughts / Behavior / Feelings grid */
    .impact-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; margin-top: 46px; }
    .impact-card {
      background: rgba(255,255,255,.055);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: var(--radius);
      padding: 28px 30px;
      transition: transform .22s ease, border-color .22s ease;
    }
    .impact-card:hover { transform: translateY(-4px); border-color: rgba(216,184,102,.42); }
    .impact-card .label { color: var(--champagne); font-size: 11px; font-weight: 900; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 16px; display: block; }
    .impact-card h3 { margin-bottom: 14px; color: var(--white); font-size: 22px; }
    .impact-list { list-style: none; display: grid; gap: 8px; }
    .impact-list li { color: rgba(255,255,255,.68); font-size: 15px; padding-left: 18px; position: relative; }
    .impact-list li::before { content: '›'; position: absolute; left: 0; color: var(--champagne); font-size: 18px; font-weight: 700; line-height: 1; top: 1px; }

    /* Hub diagram: at-a-glance map above the detail cards */
    .hub { position: relative; margin-top: 48px; display: grid; grid-template-columns: 1fr 210px 1fr; gap: 20px 44px; align-items: center; }
    .hub-lines { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 260px; height: 260px; overflow: visible; pointer-events: none; }
    .hub-node, .hub-core { position: relative; z-index: 1; }
    .hub-node {
      background: rgba(255,255,255,.055);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: var(--radius);
      padding: 24px 26px;
    }
    .hub-node .label { color: var(--champagne); font-size: 11px; font-weight: 900; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 12px; display: block; }
    .hub-node ul { list-style: none; display: grid; gap: 7px; }
    .hub-node li { color: rgba(255,255,255,.7); font-size: 15px; line-height: 1.5; padding-left: 16px; position: relative; }
    .hub-node li::before { content: ''; position: absolute; left: 0; top: 9px; width: 5px; height: 5px; border-radius: 50%; background: var(--champagne); opacity: .85; }
    .hub-core {
      justify-self: center; align-self: center;
      width: 150px; height: 150px; border-radius: 50%;
      display: grid; place-items: center; text-align: center;
      background: radial-gradient(circle at 50% 50%, rgba(216,184,102,.28), rgba(216,184,102,.06) 72%);
      border: 1.5px solid rgba(216,184,102,.95);
      box-shadow: 0 0 96px rgba(216,184,102,.34), 0 0 32px rgba(216,184,102,.3), inset 0 0 32px rgba(216,184,102,.11);
      font-family: var(--serif); font-size: 25px; color: var(--champagne); letter-spacing: -.02em;
    }
    .hub-core { grid-column: 2; grid-row: 1 / span 2; }
    .hub-core::before, .hub-core::after {
      content: ''; position: absolute; inset: -2px; border-radius: 50%;
      border: 1px solid rgba(216,184,102,.75);
      animation: hubPulse 5.2s cubic-bezier(.25,.6,.35,1) infinite;
      pointer-events: none;
    }
    .hub-core::after { animation-delay: 2.6s; }
    @keyframes hubPulse {
      0%   { transform: scale(1);    opacity: .8; }
      78%  { opacity: 0; }
      100% { transform: scale(1.46); opacity: 0; }
    }
    .hub-lines line { stroke-dasharray: 5 7; animation: hubFlow 4s linear infinite; }
    @keyframes hubFlow { to { stroke-dashoffset: -24; } }
    @media (prefers-reduced-motion: reduce) {
      .hub-core::before { animation: none; opacity: .5; transform: none; }
      .hub-core::after { display: none; }
      .hub-lines line { animation: none; stroke-dasharray: none; }
    }
    .hub-n1 { grid-column: 1; grid-row: 1; }
    .hub-n2 { grid-column: 3; grid-row: 1; }
    .hub-n3 { grid-column: 1; grid-row: 2; }
    .hub-n4 { grid-column: 3; grid-row: 2; }
    @media (max-width: 860px) {
      .hub { grid-template-columns: 1fr; gap: 16px; }
      .hub-lines { display: none; }
      .hub-core, .hub-n1, .hub-n2, .hub-n3, .hub-n4 { grid-column: 1; grid-row: auto; }
      .hub-core { width: 130px; height: 130px; font-size: 22px; margin-bottom: 4px; }
    }

    /* Cycle steps */
    .cycle-steps { display: grid; gap: 18px; margin-top: 42px; }
    .cycle-step { display: grid; grid-template-columns: 76px 1fr; gap: 22px; background: var(--white); border: 1px solid rgba(20,33,50,.08); border-radius: 24px; padding: 24px; }
    .step-number { width: 56px; height: 56px; display: grid; place-items: center; border-radius: 50%; background: var(--night); color: var(--champagne); font-family: var(--serif); font-size: 22px; }
    .cycle-step h3 { font-size: 23px; margin-bottom: 8px; }

    /* Stat strip */
    .stat-strip { background: var(--white); border: 1px solid rgba(20,33,50,.08); border-radius: 24px; padding: 32px; box-shadow: 0 18px 50px rgba(20,33,50,.07); display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
    .stat-item { text-align: center; }
    .stat-item strong { display: block; font-family: var(--serif); color: var(--night); font-size: 36px; line-height: 1; margin-bottom: 8px; }
    .stat-item span { color: var(--muted); font-size: 14px; }

    /* Quote card */
    .quote-card { background: var(--night); color: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 40px; }
    .quote-card p { color: rgba(255,255,255,.78); font-family: var(--serif); font-size: 26px; line-height: 1.4; max-width: unset; }
    .quote-card small { display: block; color: var(--champagne); margin-top: 22px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; font-size: 11px; }

    /* CTA section */
    .final-cta { background: var(--ink); color: var(--white); text-align: center; padding: 110px 0; position: relative; overflow: hidden; }
    .final-cta::before { content: ''; position: absolute; width: 540px; height: 540px; border-radius: 50%; background: radial-gradient(circle, rgba(216,184,102,.14), transparent 68%); top: -220px; right: -160px; pointer-events: none; }
    .final-cta .container { position: relative; z-index: 2; }
    .final-cta h2 { color: var(--white); max-width: 860px; margin: 0 auto 22px; }
    .final-cta p { margin: 0 auto 34px; color: rgba(255,255,255,.72); font-size: 19px; }

    /* Footer */
    footer { background: #000000; color: rgba(255,255,255,.6); padding: 58px 0 38px; }
    .footer-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: 28px; }
    footer h3, footer h4 { color: var(--white); }
    footer h3 { font-size: 29px; margin-bottom: 12px; }
    footer h4 { font-family: var(--sans); font-size: 12px; text-transform: uppercase; letter-spacing: .16em; margin-bottom: 14px; color: var(--champagne); }
    footer ul { list-style: none; display: grid; gap: 10px; }
    footer a { color: rgba(255,255,255,.68); }
    footer a:hover { color: var(--white); }
    .copyright { border-top: 1px solid rgba(255,255,255,.08); margin-top: 42px; padding-top: 24px; font-size: 13px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

    .floating-cta { position: fixed; right: 18px; bottom: 18px; z-index: 60; box-shadow: 0 18px 50px rgba(0,0,0,.25); }
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.visible { opacity: 1; transform: none; }

    @media (max-width: 900px) {
      .nav-links { display: none; position: absolute; top: 76px; left: 0; right: 0; padding: 20px 24px 28px; background: rgba(8,11,16,.96); flex-direction: column; align-items: flex-start; border-bottom: 1px solid rgba(255,255,255,.08); }
      .nav-links.open { display: flex; }
      .nav-toggle { display: block; }
      .page-hero { padding-top: 124px; }
      .cards-3, .cards-4, .light-cards-3, .light-cards-4, .impact-grid, .stat-strip, .footer-grid { grid-template-columns: 1fr; }
      .cards-2, .light-cards-2 { grid-template-columns: 1fr; }
      .cycle-step { grid-template-columns: 1fr; }
      .step-number { width: 46px; height: 46px; font-size: 18px; }
      .section { padding: 78px 0; }
      .floating-cta { left: 18px; right: 18px; width: auto; }
      .floating-cta .btn { width: 100%; }
      .what-is-grid { grid-template-columns: 1fr !important; }
    }
  </style>
  <style id="guide-extra-styles">
    /* "X is not" chips: the inherited champagne-on-cream was near-invisible
       on the light section, so these carry a dark label and a gold mark. */
    .myth-intro {
      display: block;
      color: var(--night);
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -.01em;
      margin-bottom: 20px;
    }
    .myth-busted { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 0; }
    .myth-tag {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      background: var(--white);
      border: 1px solid rgba(20,33,50,.09);
      color: var(--night);
      font-size: 14.5px;
      font-weight: 700;
      letter-spacing: 0;
      padding: 13px 22px 13px 14px;
      margin: 0;
      border-radius: 999px;
      box-shadow: 0 10px 28px rgba(20,33,50,.07);
      transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }
    .myth-tag::before {
      content: '\2715';
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 25px;
      height: 25px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--champagne), var(--gold));
      color: #16100a;
      font-size: 11px;
      font-weight: 900;
      line-height: 1;
    }
    .myth-tag:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 40px rgba(20,33,50,.12);
      border-color: rgba(216,184,102,.55);
    }
    /* Keep the dark-section variant legible where the background is ink. */
    .dark-section .myth-tag {
      background: rgba(255,255,255,.05);
      border-color: rgba(216,184,102,.3);
      color: var(--white);
      box-shadow: none;
    }
    @media (max-width: 600px) {
      .myth-tag { font-size: 13.5px; padding: 11px 18px 11px 12px; }
    }

    .stat-panel {
      position: relative;
      overflow: hidden;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      background: linear-gradient(140deg, var(--night), var(--navy) 60%, var(--ink));
      border: 1px solid rgba(216,184,102,.4);
      border-radius: var(--radius);
      padding: 52px 46px;
      margin-top: 52px;
      box-shadow: 0 30px 90px rgba(8,11,16,.2);
    }
    .stat-panel::before {
      content: '';
      position: absolute;
      width: 420px; height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(216,184,102,.15), transparent 68%);
      top: -180px; right: -120px;
      pointer-events: none;
    }
    .stat-cell { position: relative; z-index: 2; padding: 0 36px; }
    .stat-cell:first-child { padding-left: 0; }
    .stat-cell:last-child { padding-right: 0; }
    .stat-cell + .stat-cell { border-left: 1px solid rgba(216,184,102,.24); }
    .stat-label {
      display: block;
      color: var(--champagne);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .16em;
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .stat-cell strong {
      display: block;
      font-family: var(--serif);
      color: var(--white);
      font-size: 33px;
      line-height: 1.12;
      font-weight: 600;
      margin-bottom: 12px;
    }
    .stat-cell > span:last-child {
      display: block;
      color: rgba(255,255,255,.68);
      font-size: 14.5px;
      line-height: 1.6;
    }
    @media (max-width: 900px) {
