  <script>
    const navToggle = document.getElementById('nav-toggle');
    const navLinks = document.getElementById('nav-links');
    navToggle.addEventListener('click', () => {
      const open = navLinks.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    navLinks.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      navLinks.classList.remove('open');
      navToggle.setAttribute('aria-expanded', 'false');
    }));
    document.getElementById('year').textContent = new Date().getFullYear();

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
    }, { threshold: .12 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>

  <!-- Phone auto-format + SMS opt-in reveal -->
  <script>
    const phoneEl = document.getElementById('phone');
    const smsWrap = document.getElementById('sms-opt-in-wrapper');
    const smsCheckEl = document.getElementById('sms_opt_in');

    function phoneDigits() {
      return phoneEl.value.replace(/\D/g, '');
    }

    phoneEl.addEventListener('input', function (e) {
      const digits = e.target.value.replace(/\D/g, '').substring(0, 10);
      if (digits.length === 0) { e.target.value = ''; }
      else if (digits.length <= 3) { e.target.value = '(' + digits; }
      else if (digits.length <= 6) { e.target.value = '(' + digits.substring(0,3) + ') ' + digits.substring(3); }
      else { e.target.value = '(' + digits.substring(0,3) + ') ' + digits.substring(3,6) + '-' + digits.substring(6); }

      // Reveal SMS opt-in only when a complete 10-digit number has been entered.
      // If the user clears the phone field, also uncheck the box so we never
      // record consent paired with an empty phone number.
      const hasValidPhone = phoneDigits().length === 10;
      smsWrap.style.display = hasValidPhone ? 'block' : 'none';
      if (!hasValidPhone) smsCheckEl.checked = false;
    });
  </script>

  <!-- Firebase SDK -->
  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js';
    import { getFirestore, collection, addDoc, serverTimestamp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js';

    const firebaseConfig = {
      apiKey: "AIzaSyARzjrwt_Asr-_ca5bBYUBoFUMKM8sRAFc",
      authDomain: "therapy-by-david.firebaseapp.com",
      projectId: "therapy-by-david",
      storageBucket: "therapy-by-david.firebasestorage.app",
      messagingSenderId: "45351635355",
      appId: "1:45351635355:web:3da34281325675f125793e"
    };

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    // ── SMS consent record ──────────────────────────────────────────────────
    // Versioned so that if the consent language is ever updated, historical
    // submissions still point to the exact wording the user saw. This entire
    // record is what would be produced in a TCPA/TCR audit.
    const SMS_CONSENT_VERSION = '2026-06-01-v2';
    const SMS_CONSENT_TEXT =
      'I agree to SMS from Therapy by David (scheduling, reminders). ' +
      'Reply STOP to cancel, HELP for help. ' +
      'Frequency varies. Msg & data rates may apply. ' +
      'SMS Terms (https://therapybydavid.com/sms-terms.html) · ' +
      'Privacy Policy (https://therapybydavid.com/privacy.html).';
    // ────────────────────────────────────────────────────────────────────────

    document.getElementById('contact-form').addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn    = document.getElementById('submit-btn');
      const status = document.getElementById('form-status');
      const smsCheck = document.getElementById('sms_opt_in');
      const phoneVal = document.getElementById('phone').value.trim();
      const hasValidPhone = phoneVal.replace(/\D/g, '').length === 10;
      const smsOptIn = smsCheck.checked && hasValidPhone;

      // First-touch lead source captured by /analytics.js on whichever
      // page this visitor landed on first this session.
      let leadSrc = {};
      try { leadSrc = JSON.parse(sessionStorage.getItem('tbd_source')) || {}; } catch (err) {}

      const data   = {
        first_name: document.getElementById('first_name').value.trim(),
        last_name:  document.getElementById('last_name').value.trim(),
        from_email: document.getElementById('email').value.trim(),
        phone:      phoneVal,
        message:    document.getElementById('message').value.trim(),
        submitted_at: serverTimestamp(),

        // ── SMS consent audit trail (TCR/TCPA defensible record) ──
        sms_opt_in:            smsOptIn,
        sms_consent_version:   smsOptIn ? SMS_CONSENT_VERSION : null,
        sms_consent_text:      smsOptIn ? SMS_CONSENT_TEXT    : null,
        sms_consent_timestamp: smsOptIn ? serverTimestamp()   : null,
        sms_consent_page:      smsOptIn ? location.href       : null,
        user_agent:            navigator.userAgent,

        // ── Lead source attribution (first touch, see /analytics.js) ──
        lead_referrer:     leadSrc.referrer     || null,
        lead_landing_page: leadSrc.landing_page || null,
        lead_utm_source:   leadSrc.utm_source   || null,
        lead_utm_medium:   leadSrc.utm_medium   || null,
        lead_utm_campaign: leadSrc.utm_campaign || null,
        lead_first_seen:   leadSrc.first_seen   || null
      };

      // ── TURNSTILE spam-protection gate: INACTIVE until keys are added ──
      // Uncomment to require a valid Turnstile token before saving the lead.
      // Pair with the widget + script in the form markup above, and set
      // TURNSTILE_SECRET_KEY in Cloudflare (see functions/verify-turnstile.js).
      //
      // const tsToken = (window.turnstile && turnstile.getResponse()) || '';
      // const tsOk = await fetch('/verify-turnstile', {
      //   method: 'POST', headers: { 'Content-Type': 'application/json' },
      //   body: JSON.stringify({ token: tsToken }),
      // }).then(r => r.json()).then(d => d.success).catch(() => false);
      // if (!tsOk) {
      //   const s = document.getElementById('form-status');
      //   s.style.display = 'block';
      //   s.textContent = 'Please complete the spam check and try again.';
      //   return;
      // }

      btn.disabled    = true;
      btn.textContent = 'Sending…';

      try {
        // 1. Save to Firestore (must succeed; this is the canonical record)
        await addDoc(collection(db, 'contact_submissions'), data);

        if (typeof gtag === 'function') gtag('event', 'form_submit', { form: 'contact' });

        // 2. Fire-and-forget notification pipeline via the openpath-intake
        // Worker. NOT awaited; a Worker hiccup must not break the form for
        // the visitor. The Worker has Textbelt / Twilio / Resend / Trello /
        // Anthropic keys server-side so they never leak to the browser.
        // Worker does: Textbelt SMS alert to David, Trello card in "New Lead",
        // Twilio welcome SMS to opted-in visitors, and an AI-drafted Gmail
        // reply landing in David's Drafts folder. EmailJS was removed
        // 2026-05-31: the Worker now covers every notification path it used
        // to provide (and more).
        fetch('https://openpath-intake.roblesinc.workers.dev/contact-notify', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({
            first_name: data.first_name,
            last_name:  data.last_name,
            from_email: data.from_email,
            phone:      data.phone,
            message:    data.message,
            sms_opt_in: data.sms_opt_in,
            // one-line source summary for the Trello card / SMS alert;
            // the Worker may ignore it, full detail lives in Firestore
            lead_source: leadSrc.utm_source || leadSrc.referrer || '(direct)',
          }),
        }).catch(() => {});  // ignore worker errors silently

        // Success
        status.style.display      = 'block';
        status.style.background   = '#e6f4ea';
        status.style.color        = '#1a7c34';
        status.textContent        = '✓ Message sent. David will be in touch within 24 hours.';
        e.target.reset();
      } catch (err) {
        console.error(err);
        status.style.display      = 'block';
        status.style.background   = '#fdecea';
        status.style.color        = '#b71c1c';
        status.textContent        = 'Something went wrong. Please try again or email directly.';
      } finally {
        btn.disabled    = false;
        btn.textContent = 'Send Message';
      }
    });
  </script>

