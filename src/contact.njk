<body>

  {% include "nav.njk" %}

  <main>

    <!-- HERO -->
    <section class="page-hero">
      <div class="container reveal">
        <span class="eyebrow">Get in Touch</span>
        <h1>Let's start a <em>conversation.</em></h1>
        <p class="lead">No pressure, no commitment. Reach out with a question or find the right way to connect below.</p>
      </div>
    </section>

    <!-- CONTACT INFO -->
    <section class="section contact-info-section">
      <div class="container">

        <!-- Contact Form -->
        <div class="message-grid reveal" style="margin-bottom: 32px;">

          <div class="message-intro">
            <span class="eyebrow">Send a Message</span>
            <h2>Have a question? Reach out.</h2>
            <p class="section-lead">Fill out the form and David will get back to you personally within 24 hours.</p>

            <div class="assurances">
              <div class="assurance">
                <span class="assurance-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                </span>
                <div>
                  <strong>A reply within 24 hours</strong>
                  <span>David reads and answers every message himself.</span>
                </div>
              </div>
              <div class="assurance">
                <span class="assurance-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                </span>
                <div>
                  <strong>Private either way</strong>
                  <span>What you write stays between you and David.</span>
                </div>
              </div>
              <div class="assurance">
                <span class="assurance-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 0 0-7.1 7.1l8.8 8.8 8.8-8.8a5 5 0 0 0 0-7.1z"/></svg>
                </span>
                <div>
                  <strong>No commitment</strong>
                  <span>Asking a question is not booking anything.</span>
                </div>
              </div>
            </div>
          </div>

          <div class="form-card">
          <form id="contact-form" class="form-grid">
            <div class="field-row">
              <div class="field">
                <label for="first_name">First Name</label>
                <input type="text" id="first_name" required placeholder="">
              </div>
              <div class="field">
                <label for="last_name">Last Name</label>
                <input type="text" id="last_name" required placeholder="">
              </div>
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" required placeholder="">
            </div>
            <div class="field">
              <label for="phone">Phone (optional)</label>
              <input type="tel" id="phone" placeholder="">
            </div>

            <!-- SMS opt-in (revealed only when a valid phone is entered) -->
            <div id="sms-opt-in-wrapper" style="display: none; padding: 16px 18px; background: var(--paper); border: 1px solid var(--mist); border-radius: 12px;">
              <label for="sms_opt_in" style="display: flex; gap: 12px; align-items: flex-start; cursor: pointer; font-size: 13px; line-height: 1.55; color: var(--text); margin: 0;">
