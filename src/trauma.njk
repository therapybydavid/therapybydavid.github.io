    }
    .eyebrow::before { content: ''; width: 34px; height: 1px; background: currentColor; opacity: .6; }
    h1, h2, h3 { font-family: var(--serif); color: var(--night); line-height: 1.05; letter-spacing: -.03em; }
    h1 { font-size: clamp(46px, 7vw, 92px); font-weight: 700; }
    h2 { font-size: clamp(34px, 4.5vw, 58px); font-weight: 700; margin-bottom: 20px; }
