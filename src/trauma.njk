    .container { max-width: var(--max); margin: 0 auto; padding: 0 24px; }
    .section { padding: 104px 0; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--gold);
      font-size: 12px;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-weight: 800;
