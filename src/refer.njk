    <!-- WHO + LOGISTICS -->
    <section class="section">
      <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; align-items: start;">

          <div class="reveal" style="background: var(--white); border: 1px solid rgba(20,33,50,.08); border-radius: 28px; padding: 40px; box-shadow: 0 18px 60px rgba(20,33,50,.09);">
            <span class="eyebrow">Who I Help</span>
            <h2 style="margin-bottom: 16px;">Adults 18 and over.</h2>
            <ul style="list-style: none; display: grid; grid-template-columns: 1fr; gap: 8px; margin-bottom: 20px;">
              <li style="padding-left: 22px; position: relative;"><span style="position:absolute;left:0;color:var(--gold);font-weight:800;">&#10003;</span>Anxiety &amp; overthinking</li>
              <li style="padding-left: 22px; position: relative;"><span style="position:absolute;left:0;color:var(--gold);font-weight:800;">&#10003;</span>Trauma &amp; PTSD</li>
              <li style="padding-left: 22px; position: relative;"><span style="position:absolute;left:0;color:var(--gold);font-weight:800;">&#10003;</span>Burnout &amp; chronic stress</li>
              <li style="padding-left: 22px; position: relative;"><span style="position:absolute;left:0;color:var(--gold);font-weight:800;">&#10003;</span>Depression</li>
              <li style="padding-left: 22px; position: relative;"><span style="position:absolute;left:0;color:var(--gold);font-weight:800;">&#10003;</span>Couples therapy</li>
              <li style="padding-left: 22px; position: relative;"><span style="position:absolute;left:0;color:var(--gold);font-weight:800;">&#10003;</span>Family &amp; relationship strain</li>
              <li style="padding-left: 22px; position: relative;"><span style="position:absolute;left:0;color:var(--gold);font-weight:800;">&#10003;</span>Life &amp; career transitions</li>
            </ul>
            <p style="background: var(--cream); border-left: 3px solid var(--gold); border-radius: 0 12px 12px 0; padding: 14px 16px; font-size: 15px;"><strong style="color: var(--night);">Particular depth with:</strong> veterans and military families, first responders, men's mental health, and high-stress professionals.</p>
          </div>

          <div class="reveal" style="background: var(--white); border: 1px solid rgba(20,33,50,.08); border-radius: 28px; padding: 40px; box-shadow: 0 18px 60px rgba(20,33,50,.09);">
            <span class="eyebrow">Availability, Insurance &amp; Fees</span>
            <h2 style="margin-bottom: 16px;">Referrals seen quickly.</h2>
            <p style="background: var(--paper); border: 1px solid var(--mist); border-radius: 12px; padding: 14px 16px; margin-bottom: 18px; font-size: 15px;"><strong style="color: var(--gold);">Availability:</strong> new referrals are typically seen within 3 to 5 business days.</p>
            <p style="margin-bottom: 14px; font-size: 15px;"><strong style="color: var(--night);">Insurance:</strong> Blue Cross Blue Shield of Texas, UnitedHealthcare, Aetna, Cigna, Humana, Ambetter (Superior HealthPlan), Molina Healthcare, Community Health Choice, Medicaid &amp; CHIP, and Medicare. Billed through partner agencies; benefits verified before the first session.</p>
            <p style="margin-bottom: 14px; font-size: 15px;"><strong style="color: var(--night);">Private pay:</strong> $150 per session, confirmed upfront.</p>
            <p style="font-size: 15px;"><strong style="color: var(--night);">Free 15-minute consultation</strong> for every new client.</p>
