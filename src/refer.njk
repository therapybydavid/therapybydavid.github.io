  <style>
    :root {
      --ink: #080b10;
      --night: #101720;
      --navy: #142132;
      --champagne: #d8b866;
      --gold: #b99138;
      --cream: #f5efe3;
      --paper: #fbf8f1;
      --mist: #e8decc;
      --text: #15171b;
      --muted: #6a6258;
      --white: #ffffff;
      --line: rgba(216, 184, 102, .25);
      --shadow: 0 24px 80px rgba(0,0,0,.18);
      --radius: 28px;
      --max: 1180px;
      --serif: 'Playfair Display', Georgia, serif;
      --sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--sans);
      background: var(--paper);
      color: var(--text);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    p { color: var(--muted); max-width: 68ch; }
    .container { max-width: var(--max); margin: 0 auto; padding: 0 24px; }
    .section { padding: 104px 0; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--gold);
      font-size: 12px;
      letter-spacing: .18em;
      text-transform: uppercase;
      font-weight: 800;
      margin-bottom: 18px;
    }
    .eyebrow::before { content: ''; width: 34px; height: 1px; background: currentColor; opacity: .6; }
    h1, h2, h3 { font-family: var(--serif); color: var(--night); line-height: 1.05; letter-spacing: -.03em; }
    h1 { font-size: clamp(46px, 7vw, 92px); font-weight: 700; }
    h2 { font-size: clamp(34px, 4.5vw, 58px); font-weight: 700; margin-bottom: 20px; }
    h3 { font-size: 25px; font-weight: 650; }
    .lead { font-size: clamp(18px, 2vw, 22px); color: rgba(255,255,255,.74); line-height: 1.7; }
    .section-lead { font-size: 18px; line-height: 1.8; margin-bottom: 16px; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 54px;
      padding: 15px 25px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: .02em;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
      border: 1px solid transparent;
      cursor: pointer;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-gold { background: linear-gradient(135deg, var(--champagne), var(--gold)); color: #16100a; box-shadow: 0 16px 38px rgba(185,145,56,.32); }
    .btn-ghost { color: var(--white); border-color: rgba(255,255,255,.22); background: rgba(255,255,255,.04); backdrop-filter: blur(10px); }
    .btn-dark { color: var(--white); background: var(--night); }
    .button-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }

    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 50;
      background: rgba(8,11,16,.74);
      border-bottom: 1px solid rgba(255,255,255,.08);
      backdrop-filter: blur(18px);
    }
    .nav-inner { height: 76px; display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; flex-direction: column; line-height: 1; color: var(--white); }
    .brand strong { font-family: var(--serif); font-size: 25px; letter-spacing: -.02em; font-weight: 700; }
    .brand span { color: var(--champagne); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; margin-top: 8px; }
    .nav-links { display: flex; gap: 28px; align-items: center; list-style: none; }
    .nav-links a { color: rgba(255,255,255,.72); font-size: 14px; font-weight: 700; }
    .nav-links a:hover { color: var(--white); }
    .nav-toggle { display: none; background: transparent; border: 0; width: 42px; height: 42px; }
    .nav-toggle span { display: block; height: 2px; background: var(--white); margin: 7px; border-radius: 99px; }

    /* Page Hero */
    .page-hero {
      padding: 148px 0 86px;
      color: var(--white);
      background:
        radial-gradient(circle at 20% 50%, rgba(216,184,102,.18), transparent 40%),
        linear-gradient(135deg, rgba(8,11,16,.98) 0%, rgba(16,23,32,.94) 60%, rgba(8,11,16,.88) 100%);
      position: relative;
    }
    .refer-hero-grid {
      display: grid;
      grid-template-columns: 1.55fr 1fr;
      gap: 48px;
      align-items: center;
    }
    .refer-portrait { max-width: 280px; justify-self: end; margin: 0; }
    .cred-strip {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px 40px;
      background: var(--white); border: 1px solid rgba(20,33,50,.08);
      border-radius: 22px; padding: 26px 34px;
      box-shadow: 0 14px 44px rgba(20,33,50,.07);
    }
    .cred-strip small {
      display: block; color: var(--gold); font-size: 10.5px; letter-spacing: .16em;
      text-transform: uppercase; font-weight: 900; margin-bottom: 6px;
    }
    .cred-strip strong { color: var(--night); font-size: 16px; font-weight: 700; }
    .refer-expect-grid {
      display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center;
    }
    .page-hero::after {
      content: '';
      position: absolute; inset: auto 0 0 0; height: 120px;
      background: linear-gradient(to bottom, transparent, var(--paper));
      pointer-events: none;
    }
    .page-hero h1 { color: var(--white); max-width: 820px; margin-bottom: 26px; }
    .refer-hero-grid h1 { font-size: clamp(40px, 4.6vw, 66px); }
    .refer-hero-grid .lead { margin-bottom: 0; }
    .page-hero h1 em { color: var(--champagne); font-style: italic; }
    .page-hero .lead { margin-bottom: 36px; max-width: 580px; }

    /* Contact info cards */
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 48px; }
    .contact-card {
      background: var(--white);
      border: 1px solid rgba(20,33,50,.08);
      border-radius: var(--radius);
      padding: 34px;
      box-shadow: 0 18px 60px rgba(20,33,50,.09);
    }
    .contact-card small { color: var(--gold); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 900; display: block; margin-bottom: 14px; }
    .contact-card h3 { margin-bottom: 10px; }
    .contact-card p { margin-bottom: 20px; }

    /* Map cards */
    .map-grid { display: grid; grid-template-columns: minmax(0, 560px); justify-content: center; gap: 32px; margin-top: 48px; align-items: stretch; }
    .map-card { background: var(--paper); border: 1px solid rgba(20,33,50,.08); border-radius: var(--radius); padding: 24px; box-shadow: 0 18px 50px rgba(20,33,50,.06); display: flex; flex-direction: column; }
    .map-card iframe { width: 100%; height: 300px; border: 0; border-radius: 20px; margin: 18px 0; flex: 1; }
    .map-card h3 { margin-bottom: 8px; }

    /* CTA */
    .final-cta { background: var(--ink); color: var(--white); text-align: center; padding: 110px 0; }
    .final-cta h2 { color: var(--white); max-width: 860px; margin: 0 auto 22px; }
    .final-cta p { margin: 0 auto 34px; color: rgba(255,255,255,.72); font-size: 19px; }

    /* Footer */
    footer { background: #000000; color: rgba(255,255,255,.6); padding: 58px 0 38px; }
    .footer-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr 1fr; gap: 28px; }
    footer h3, footer h4 { color: var(--white); }
    footer h3 { font-size: 29px; margin-bottom: 12px; }
    footer h4 { font-family: var(--sans); font-size: 12px; text-transform: uppercase; letter-spacing: .16em; margin-bottom: 14px; color: var(--champagne); }
    footer ul { list-style: none; display: grid; gap: 10px; }
    footer a { color: rgba(255,255,255,.68); }
    footer a:hover { color: var(--white); }
    .copyright { border-top: 1px solid rgba(255,255,255,.08); margin-top: 42px; padding-top: 24px; font-size: 13px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.visible { opacity: 1; transform: none; }

    /* "Prefer Texting?" CTA: text + buttons side-by-side on desktop,
       stacked + centered on mobile so the phone number doesn't wrap. */
    .prefer-texting-grid { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; }
    .prefer-texting-grid .ptg-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* First content section after the hero: reduce top padding so the
       hero's bottom padding + gradient overlay don't compound into a
       gigantic dead zone above the first CTA card. */
    .contact-info-section { padding-top: 24px; }

    @media (max-width: 900px) {
      .nav-links { display: none; position: absolute; top: 76px; left: 0; right: 0; padding: 20px 24px 28px; background: rgba(8,11,16,.96); flex-direction: column; align-items: flex-start; border-bottom: 1px solid rgba(255,255,255,.08); }
      .nav-links.open { display: flex; }
      .nav-toggle { display: block; }
      .page-hero { padding: 124px 0 40px; }
      .refer-hero-grid { grid-template-columns: 1fr; gap: 32px; }
      .refer-portrait { max-width: 210px; justify-self: start; }
      .refer-expect-grid { grid-template-columns: 1fr; gap: 24px; }
      .contact-grid, .map-grid, .footer-grid { grid-template-columns: 1fr; }
      .section { padding: 78px 0; }
      .contact-info-section { padding-top: 10px; }
      .prefer-texting-grid { grid-template-columns: 1fr; gap: 18px; text-align: center; }
      .prefer-texting-grid .ptg-actions { justify-content: center; }
    }
  </style>
