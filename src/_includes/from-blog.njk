{# --- "From the blog" cluster links: set `fromBlog` (list of {href,title}) before including --- #}
<style>
  .from-blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
  .from-blog-card { display: flex; flex-direction: column; justify-content: space-between; gap: 18px; background: var(--paper, #fff); border: 1px solid var(--line); border-radius: var(--radius, 18px); padding: 28px; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .from-blog-card:hover { transform: translateY(-4px); box-shadow: 0 18px 44px rgba(10, 20, 35, .1); }
  .from-blog-card-title { font-size: 19px; font-weight: 600; line-height: 1.35; color: var(--ink); }
  .from-blog-more { font-size: 13px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--navy); }
  @media (max-width: 900px) { .from-blog-grid { grid-template-columns: 1fr; } }
</style>
<section class="section" id="from-the-blog">
  <div class="container">
    <span class="eyebrow">From the Blog</span>
    <h2>Read more on this.</h2>
    <p class="section-lead" style="margin-top: 16px;">Articles that go deeper into how this shows up — and what working on it actually looks like.</p>
    <div class="from-blog-grid">
      {% for p in fromBlog %}
      <a class="from-blog-card reveal" href="{{ p.href }}">
        <span class="from-blog-card-title">{{ p.title }}</span>
        <span class="from-blog-more">Read the article &rarr;</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
