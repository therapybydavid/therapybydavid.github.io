{# BlogPosting schema derived from the post's own frontmatter + rendered body,
   so image, dates, and word count can never drift from the visible page. #}
{% set schemaImage = image %}
{% if schemaImage and schemaImage[0] == "/" %}{% set schemaImage = "https://therapybydavid.com" + schemaImage %}{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  {# Every interpolation is guarded. An undefined value renders as an empty
     string, which would emit a bare `,` and silently invalidate the whole
     block — the build would still succeed and Google would drop the markup. #}
  "headline": {{ (title or "Therapy by David") | dump | safe }},
  "description": {{ (description or deck or title or "") | dump | safe }},
  {% if schemaImage %}"image": {{ schemaImage | dump | safe }},{% endif %}
  "url": {{ (canonical or ("https://therapybydavid.com" + (page.url | cleanUrl))) | dump | safe }},
  "mainEntityOfPage": {"@type": "WebPage", "@id": {{ (canonical or ("https://therapybydavid.com" + (page.url | cleanUrl))) | dump | safe }}},
  "datePublished": "{{ page.date | dateISO }}",
  "dateModified": "{{ (dateModified or (page.inputPath | gitLastmod) or page.date) | dateISO }}",
  "wordCount": {{ content | wordCount }},
  "inLanguage": "en-US",
  {% if tag %}"articleSection": {{ tag | dump | safe }},{% endif %}
  "author": {
    "@type": "Person",
    "name": "David Robles",
    "jobTitle": "Licensed Master Social Worker, Psychotherapist",
    "url": "https://therapybydavid.com/about",
    "sameAs": [
      "https://www.psychologytoday.com/us/therapists/david-robles-houston-tx/1668640",
      "https://www.zocdoc.com/professional/david-robles-lmsw-702330"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Therapy by David",
    "url": "https://therapybydavid.com/"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://therapybydavid.com/"},
    {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://therapybydavid.com/blog"},
    {"@type": "ListItem", "position": 3, "name": {{ (title or "Article") | dump | safe }}}
  ]
}
</script>
<article>
<header class="article-hero">
  <div class="container">
    <a href="/blog" class="back-link">All Articles</a>
    <div class="article-meta">
      {% if tag %}<span class="tag">{{ tag }}</span>{% endif %}
      <span class="article-date">{{ dateDisplay }}</span>
    </div>
    <h1>{{ title }}</h1>
    {% if deck %}<p class="deck">{{ deck }}</p>{% endif %}
    <div class="author-row">
      <img src="/david-robles-profile-96.webp" width="48" height="48" alt="David Robles" class="author-avatar" onerror="this.onerror=null;this.style.background='#142132'">
      <div class="author-info">
        <strong>David Robles, LMSW</strong>
        <span>Psychotherapist · Houston, Texas</span>
      </div>
    </div>
  </div>
</header>

{% if image %}
<div class="featured-image">
  {# LCP element on desktop. fetchpriority tells the browser to start it ahead of
     the other subresources instead of at default priority. #}
  <img src="{{ image }}" alt="{{ imageAlt or title }}" width="1400" height="630" loading="eager" fetchpriority="high" decoding="async" />
</div>
{% endif %}

<main class="article-body">
  <div class="prose">
    {{ content | safe }}
  </div>

  {# Visible FAQ: rendered from the same faqJson that powers the FAQPage schema,
     so the structured data matches what readers actually see on the page. #}
  {% set faqData = faqJson | fromJson %}
  {% if faqData and faqData.mainEntity %}
  <section class="faq" id="faq">
    <h2 class="faq-heading">Frequently asked questions</h2>
    {% for item in faqData.mainEntity %}
    <details class="faq-item"{% if loop.first %} open{% endif %}>
      <summary>{{ item.name }}</summary>
      <p>{{ item.acceptedAnswer.text }}</p>
    </details>
    {% endfor %}
  </section>
  {% endif %}

  <div class="article-cta">
    <h3>{{ ctaHeading or "Ready to work on this?" }}</h3>
    <p>{{ ctaText or "Schedule a free 15-minute consultation. No pressure, just a real conversation about what's going on and what support might help." }}</p>
    <a class="btn btn-gold" href="/intake">Book a Free 15-Minute Call</a>
  </div>
</main>

{# --- Internal linking: matching service page + related posts by tag --- #}
{% set serviceMap = {
  "Anxiety": ["/anxiety-therapy", "Anxiety therapy in Texas"],
  "Depression": ["/depression-therapy", "Depression therapy in Texas"],
  "Trauma": ["/trauma-therapy", "Trauma therapy in Texas"],
  "Burnout": ["/burnout-overthinking", "Help with burnout & overthinking"],
  "Veterans": ["/veterans-military-families", "Therapy for veterans & military families"],
  "Men's Mental Health": ["/mens-mental-health", "Men's mental health"],
  "Relationships": ["/couples-therapy", "Couples & relationship therapy"],
  "Getting Started": ["/book/", "Book a free 15-minute consultation"],
  "First Responders": ["/first-responders", "Therapy for first responders"],
  "Mental Health": ["/contact", "Talk with a therapist in Texas"],
  "Grief": ["/trauma-therapy", "Grief and trauma therapy in Texas"],
  "Self-Worth": ["/depression-therapy", "Therapy for self-worth and depression in Texas"]
} %}
{% set service = serviceMap[tag] %}
{# Ring selection: each post links to the four posts that FOLLOW it within its own
   tag, wrapping around. The old version took the newest four in the tag for every
   post, so in a 15-post tag the same four collected every link and ten posts got
   none. This gives every post in a tag roughly four inbound links. #}
{% set sameTag = [] %}
{% for post in collections.posts %}
  {% if post.data.tag == tag %}{% set _ = sameTag.push(post) %}{% endif %}
{% endfor %}
{% set tIdx = [] %}
{% for p in sameTag %}
  {% if p.url == page.url %}{% set _ = tIdx.push(loop.index0) %}{% endif %}
{% endfor %}
{% set myTagIndex = tIdx[0] or 0 %}
{% set gIdx = [] %}
{% for p in collections.posts %}
  {% if p.url == page.url %}{% set _ = gIdx.push(loop.index0) %}{% endif %}
{% endfor %}
{% set myGlobalIndex = gIdx[0] or 0 %}

{% set related = [] %}
{% set takenUrls = [page.url] %}
{# Three from the tag ring, so the links stay topically relevant. #}
{% for i in range(1, 4) %}
  {% if i < sameTag.length %}
    {% set c = sameTag[(myTagIndex + i) % sameTag.length] %}
    {% if c.url not in takenUrls %}{% set _ = related.push(c) %}{% set _ = takenUrls.push(c.url) %}{% endif %}
  {% endif %}
{% endfor %}
{# The fourth slot always comes from the GLOBAL ring. Because every post fills
   this slot with its own successor in collections.posts, every post is some
   other post's successor, so no post can end up with zero inbound links. This
   also covers tags that only have one post in them. #}
{% for i in range(1, 10) %}
  {% if related.length < 4 %}
    {% set c = collections.posts[(myGlobalIndex + i) % collections.posts.length] %}
    {% if c.url not in takenUrls %}{% set _ = related.push(c) %}{% set _ = takenUrls.push(c.url) %}{% endif %}
  {% endif %}
{% endfor %}

<aside class="related">
  {% if service %}
  <a class="related-service" href="{{ service[0] }}">
    <span class="related-kicker">Explore</span>
    <span class="related-service-title">{{ service[1] }} &rarr;</span>
  </a>
  {% endif %}
  {% if related.length %}
  <h2 class="related-heading">Keep reading</h2>
  <div class="related-grid">
    {% for r in related.slice(0, 4) %}
    <a class="related-card" href="{{ r.data.canonical }}">
      <span class="tag">{{ r.data.tag }}</span>
      <span class="related-card-title">{{ r.data.title }}</span>
    </a>
    {% endfor %}
  </div>
  {% endif %}
  <a class="related-all" href="/blog">Browse all articles &rarr;</a>
</aside>
</article>
