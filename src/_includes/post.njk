---
layout: base.njk
ogType: article
schemaType: BlogPosting
---
<header class="article-hero">
  <div class="container">
    <a href="/blog/" class="back-link">All Articles</a>
    <div class="article-meta">
      {% if tag %}<span class="tag">{{ tag }}</span>{% endif %}
      <span class="article-date">{{ page.date | readableDate }}{% if readTime %} &middot; {{ readTime }}{% endif %}</span>
    </div>
    <h1>{{ title }}</h1>
    {% if deck %}<p class="deck">{{ deck }}</p>{% endif %}
    <div class="author-row">
      <img src="/david-robles-profile.jpeg" alt="{{ site.author.name }}" class="author-avatar">
      <div class="author-info">
        <strong>{{ site.author.name }}, {{ site.author.credentials }}</strong>
        <span>Psychotherapist &middot; {{ site.author.location }}</span>
      </div>
    </div>
  </div>
</header>

{% if image %}
<div class="featured-image">
  <img src="{{ image }}" alt="{{ title }}" />
</div>
{% endif %}

<main class="article-body">
  <div class="prose">
    {{ content | safe }}
  </div>

  <div class="article-cta">
    <h3>Ready to work on this?</h3>
    <p>Schedule a free 15-minute consultation. No pressure &mdash; just a real conversation about what's going on and what support might help.</p>
    <a class="btn btn-gold" href="/intake.html">Book a Free Consultation</a>
  </div>
</main>
